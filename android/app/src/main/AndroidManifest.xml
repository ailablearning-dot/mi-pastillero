<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- La pantalla que sale encima del bloqueo cuando toca una dosis. Ver AlarmaActivity.java.
             excludeFromRecents: es una alarma, no un sitio al que volver deslizando en recientes.
             showOnLockScreen + turnScreenOn se piden además desde el código, porque estos atributos
             del manifiesto no existen antes de API 27 y el código sí cubre las dos vías. -->
        <activity
            android:name=".AlarmaActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/AppTheme.NoActionBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ALARMAS EXACTAS. Es el permiso del que depende que esta app sirva para algo.
         Sin él, @capacitor/local-notifications NO falla: cae en silencio a alarmas
         INEXACTAS (ver su LocalNotificationManager.java, setExactIfPossible) y el sistema
         decide cuándo entrega el aviso. Un "9:00" que llega a las 9:40 es una dosis mal
         tomada, con la app diciendo que todo va bien.

         USE_EXACT_ALARM (Android 13+) se concede al instalar, sin preguntar, pero está
         reservado a apps cuya función central son las alarmas y recordatorios — un
         pastillero califica — y GOOGLE PLAY OBLIGA A JUSTIFICARLO en la consola. El texto
         de esa justificación está escrito en docs/android/FASE-0.md; si se rechaza, no hay app.

         SCHEDULE_EXACT_ALARM cubre Android 12, donde USE_EXACT_ALARM todavía no existe. Ahí
         el permiso lo concede el usuario y puede revocarlo, así que el código tiene que
         comprobarlo en caliente y no darlo por hecho (fase 2). -->
    <!-- Para poder SALTARSE el No Molestar cuando el usuario lo autoriza. Declararlo no concede
         nada: solo permite que la app aparezca en la lista de "Acceso a No Molestar" de los ajustes,
         donde la persona decide. Sin esto, esa pantalla no la ofrece. -->
    <!-- ⚠️ PERMISO RESTRINGIDO POR GOOGLE PLAY. Hay que justificarlo en la consola, igual que el
         de alarmas exactas, y PUEDE RECHAZARSE. Está aquí por una razón concreta y medible:
         sin él, la exención de batería solo se puede pedir mandando a la persona a los ajustes del
         sistema, donde necesita tres toques y dos pantallas para encontrar "Sin restricciones" —
         y ahí es donde se abandona. Con él, Android enseña un diálogo de UN TOQUE encima de la app.

         El argumento para la declaración es el mismo que ya aceptaron para USE_EXACT_ALARM: esta
         app está clasificada como "Despertador", y un despertador que el sistema apaga no despierta.

         SI PLAY LO RECHAZA: se quita esta línea y ya está. El código cae solo al camino anterior
         (ver PermisosPlugin.pedirExencionBateria), así que la app sigue funcionando igual. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Que el recordatorio se apodere de la pantalla de bloqueo, como un despertador. Hace falta
         porque Samsung permite dejar las notificaciones del bloqueo en "Sólo ícono", y ahí una
         toma de medicación queda en un punto que nadie lee (comprobado en un A06 el 2026-09-24).
         ⚠️ Play RESERVA este permiso a alarmas y llamadas, y lo revisa. Va de la mano de la
         declaración de alarmas exactas que ya está enviada como "Despertador". -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
</manifest>
