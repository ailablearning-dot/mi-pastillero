# Cópialo a `keystore.properties` (mismo directorio) y rellena la contraseña.
# Ese archivo está en .gitignore y NO debe subirse nunca: lleva la contraseña en claro.
#
# Si esto se clona en otra máquina, hay que rehacerlo: la clave .jks vive fuera del repositorio
# a propósito, para que no pueda acabar en GitHub por accidente.

storeFile=/Users/jmontero/mi-pastillero-upload.jks
storePassword=AQUI_TU_CONTRASENA
keyAlias=upload
keyPassword=AQUI_TU_CONTRASENA
